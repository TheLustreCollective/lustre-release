[access]
	inheritFrom = All-Projects
[submit]
[project]
	description = Lustre development repository
[access "refs/*"]
	owner = group user/Minh Diep (mdiep25)
[access "refs/for/refs/*"]
	label-Code-Review = -2..+2 group user/Minh Diep (mdiep25)
	label-Verified = -1..+1 group user/Minh Diep (mdiep25)
	push = group user/Minh Diep (mdiep25)
	read = group user/Minh Diep (mdiep25)
	rebase = group user/Minh Diep (mdiep25)
	removeReviewer = group user/Minh Diep (mdiep25)
	submit = group user/Minh Diep (mdiep25)
[access "refs/heads/*"]
	create = group user/Minh Diep (mdiep25)
	push = +force group user/Minh Diep (mdiep25)
	pushMerge = group user/Minh Diep (mdiep25)
	read = group user/Minh Diep (mdiep25)
[access "refs/tags/*"]
	push = +force group user/Minh Diep (mdiep25)
